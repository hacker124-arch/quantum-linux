# Quantum Linux - Debian 13 Trixie / KDE Plasma 6
# Explicitly select the systemd live-config backend to match --initsystem systemd.
live-config-systemd
systemd-sysv

# ISO BIOS bootloader payloads required by live-build's ISOLINUX theme.
# syslinux-common supplies vesamenu.c32; isolinux supplies isolinux.bin.
isolinux
syslinux-common

# KDE Plasma desktop and Wayland session
kde-plasma-desktop
plasma-workspace
kwin-wayland
sddm
xwayland
dbus-user-session

# KDE applications and desktop integration
konsole
dolphin
ark
kate
systemsettings
kde-config-gtk-style
plasma-nm
plasma-pa
xdg-desktop-portal
xdg-desktop-portal-kde

# Network and system utilities
network-manager
sudo
curl
ca-certificates
gnupg
git
usbutils
pciutils
udisks2
upower
systemd-timesyncd

# Common laptop firmware
firmware-linux
firmware-misc-nonfree

# Audio and screen recording
pipewire
pipewire-audio
wireplumber
pipewire-pulse
obs-studio
v4l2loopback-dkms

# Fonts
fonts-noto
fonts-noto-color-emoji
