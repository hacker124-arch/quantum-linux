#!/bin/sh
set -eu

# live-build's ISOLINUX binary stage expects these files under /root/isolinux
# inside the target chroot. Install them from the Debian packages already
# selected in quantum.list.chroot; host-side includes are not reliable here.
ISOLINUX_BIN="$(dpkg -L isolinux | awk '/\/isolinux\.bin$/ { print; exit }')"
VESAMENU_C32="$(dpkg -L syslinux-common | awk '/\/vesamenu\.c32$/ { print; exit }')"

test -n "$ISOLINUX_BIN"
test -n "$VESAMENU_C32"
test -s "$ISOLINUX_BIN"
test -s "$VESAMENU_C32"

install -d -m 0755 /root/isolinux
install -m 0644 "$ISOLINUX_BIN" /root/isolinux/isolinux.bin
install -m 0644 "$VESAMENU_C32" /root/isolinux/vesamenu.c32
test -s /root/isolinux/isolinux.bin
test -s /root/isolinux/vesamenu.c32
echo "ISOLINUX files installed in target chroot."

export DEBIAN_FRONTEND=noninteractive

# Waydroid is optional and hardware/kernel dependent. Never fail the base ISO
# solely because the backports package or its repository is temporarily absent.
if apt-get update -o Acquire::Retries=3 &&
   apt-get install -y -t trixie-backports waydroid; then
  echo "Waydroid installed."
else
  echo "WARNING: Waydroid was not installed; the base ISO build will continue." >&2
fi

# Helium is optional. Only add its official signed repository when reachable.
if command -v curl >/dev/null 2>&1 &&
   command -v gpg >/dev/null 2>&1 &&
   curl -fsSL --retry 3 https://raw.githubusercontent.com/imputnet/helium-linux/main/pubkey.asc -o /tmp/helium-pubkey.asc &&
   gpg --dearmor --yes -o /usr/share/keyrings/helium.gpg /tmp/helium-pubkey.asc &&
   chmod 0644 /usr/share/keyrings/helium.gpg &&
   printf '%s\n' 'deb [arch=amd64 signed-by=/usr/share/keyrings/helium.gpg] https://pkg.helium.computer/deb stable main' > /etc/apt/sources.list.d/helium.list &&
   apt-get update -o Acquire::Retries=3 &&
   apt-get install -y helium-bin; then
  echo "Helium browser installed."
else
  echo "WARNING: Helium was not installed; install it later if desired." >&2
fi

apt-get clean
rm -rf /var/lib/apt/lists/* /tmp/helium-pubkey.asc
exit 0
