#!/bin/sh
set -eu

# Single source of truth for the Debian 13 live image.
# Debian 13 uses the trixie-security suite. The Ubuntu runner's live-build
# generates the obsolete trixie/updates suite when --security is enabled,
# so the current security repository is supplied through config/archives.
lb config noauto \
  --mode debian \
  --distribution trixie \
  --architectures amd64 \
  --binary-images iso-hybrid \
  --initsystem systemd \
  --archive-areas "main contrib non-free non-free-firmware" \
  --mirror-bootstrap https://deb.debian.org/debian/ \
  --mirror-chroot https://deb.debian.org/debian/ \
  --mirror-binary https://deb.debian.org/debian/ \
  --apt-recommends false \
  --apt-options "--yes -oAcquire::Retries=5 -oAcquire::http::Timeout=30" \
  --security false \
  --iso-application "Quantum Linux" \
  --iso-volume "QUANTUM_LINUX" \
  --bootappend-live "boot=live components quiet splash"
