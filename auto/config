#!/bin/sh
set -eu

# Single source of truth for the Debian 13 live image.
# Keep the workflow invoking plain "lb config" so this file is executed.
# Zstandard avoids the extremely slow default XZ SquashFS compression on
# the hosted runner while retaining good compression and full SquashFS support.
lb config noauto \
  --mode debian \
  --distribution trixie \
  --architectures amd64 \
  --binary-images iso-hybrid \
  --initsystem systemd \
  --chroot-filesystem squashfs \
  --chroot-squashfs-compression-type zstd \
  --chroot-squashfs-compression-level 3 \
  --archive-areas "main contrib non-free non-free-firmware" \
  --mirror-bootstrap https://deb.debian.org/debian/ \
  --mirror-chroot https://deb.debian.org/debian/ \
  --mirror-binary https://deb.debian.org/debian/ \
  --mirror-chroot-security https://security.debian.org/debian-security/ \
  --mirror-binary-security https://security.debian.org/debian-security/ \
  --apt-recommends false \
  --apt-options "--yes -oAcquire::Retries=5 -oAcquire::http::Timeout=30" \
  --security true \
  --iso-application "Quantum Linux" \
  --iso-volume "QUANTUM_LINUX" \
  --bootappend-live "boot=live components quiet splash"
